{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },

  "build": {
    // Developer branch for developer only
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_GNEWS_API_KEY": "$GNEWS_API_KEY",
        "EXPO_PUBLIC_NEWSAPI_KEY": "$NEWSAPI_KEY"
      }
    },

    // Preview branch for internal testing and QA
    "preview": {
      "distribution": "internal",
      "channel": "staging",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "staging",
        "EXPO_PUBLIC_GNEWS_API_KEY": "$GNEWS_API_KEY",
        "EXPO_PUBLIC_NEWSAPI_KEY": "$NEWSAPI_KEY"
      }
    },

    // Production branch for release to app stores
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_GNEWS_API_KEY": "$GNEWS_API_KEY",
        "EXPO_PUBLIC_NEWSAPI_KEY": "$NEWSAPI_KEY"
      }
    }
  },

  "submit": {
    "production": {
      "android": {
        "track": "production"
      },
      "ios": {
        "appleId": "your-apple-id@email.com"
      }
    }
  }
}
